{
  "name": "99co-homepage-automation",
  "version": "1.0.0",
  "description": "Mobile test automation for the 99.co Indonesia homepage: Appium 3 + WebdriverIO + Cucumber (Gherkin) + Page Object Model, CommonJS",
  "private": true,
  "scripts": {
    "appium": "appium",
    "test": "wdio run ./wdio.conf.js",
    "test:smoke": "wdio run ./wdio.conf.js --cucumberOpts.tags @smoke",
    "test:tag": "wdio run ./wdio.conf.js --cucumberOpts.tags",
    "scan": "node scripts/scan-locators.js",
    "doctor": "appium driver doctor uiautomator2"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/cucumber-framework": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "webdriverio": "^9.32.0"
  },
  "engines": {
    "node": ">=20"
  }
}
