{
  "name": "rumah123-automation",
  "version": "1.0.0",
  "description": "Mobile automation testing for Rumah123 Consumer App homepage revamp",
  "main": "index.js",
  "scripts": {
    "test": "npx wdio run wdio.conf.js",
    "test:smoke": "npx wdio run wdio.conf.js --cucumberOpts.tags \"@Smoke\"",
    "test:functional": "npx wdio run wdio.conf.js --cucumberOpts.tags \"@Functional\"",
    "test:ui": "npx wdio run wdio.conf.js --cucumberOpts.tags \"@UI\"",
    "allure:generate": "npx allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "npx allure open ./allure-report",
    "allure:serve": "npx allure serve ./allure-results",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:allure": "npx wdio run wdio.conf.js & npm run allure:serve"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/appium-service": "^9.19.2",
    "@wdio/cli": "^9.19.2",
    "@wdio/cucumber-framework": "^9.19.2",
    "@wdio/globals": "^9.19.2",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "allure-commandline": "^2.34.1",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^4.2.9",
    "expect-webdriverio": "^5.4.2",
    "webdriverio": "^9.19.2"
  }
}
