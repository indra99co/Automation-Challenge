{
  "name": "automation-challenge",
  "version": "1.0.0",
  "description": "Mobile automation for 99 app homepage using Appium + WebdriverIO + Cucumber",
  "type": "commonjs",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:smoke": "wdio run ./wdio.conf.js --cucumberOpts.tags=@smoke",
    "test:no-bug": "wdio run ./wdio.conf.js --cucumberOpts.tags=\"not @bug\""
  },
  "author": "Jessica Eileen",
  "license": "ISC",
  "devDependencies": {
    "@wdio/appium-service": "^10.0.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/cucumber-framework": "^10.0.1",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/spec-reporter": "^10.0.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0"
  }
}
